"  tcp_flags:    'Diversity of TCP flag combinations (SYN, ACK, PSH, RST, etc.)',\n"
"  delta_tsc:    'Inter-packet timing variation measured in TSC ticks',\n"
"  vxlan_encap:  'Entropy of VXLAN encapsulation presence (on/off)',\n"
"  outer_src_ip: 'Diversity of outer tunnel (VXLAN) source IPs',\n"
"  outer_dst_ip: 'Diversity of outer tunnel (VXLAN) destination IPs',\n"
"  vni:          'VXLAN Network Identifier entropy across encapsulated flows',\n"
"  flow_5tuple:  'Entropy of distinct 5-tuple flow keys observed in the connection table',\n"
"  flow_lifetime:'Variation in flow lifetimes — higher means more diverse durations',\n"
"  min_src_ip:   'Worst-case (minimum) source IP entropy over the observation window',\n"
"  min_dst_ip:   'Worst-case (minimum) destination IP entropy over the observation window',\n"
"  min_src_port: 'Worst-case (minimum) source port entropy over the observation window',\n"
"  min_dst_port: 'Worst-case (minimum) destination port entropy over the observation window',\n"
"  min_protocol: 'Worst-case (minimum) protocol entropy over the observation window',\n"
"  min_pkt_size: 'Worst-case (minimum) packet size entropy over the observation window',\n"
"  min_tcp_flags: 'Worst-case (minimum) TCP flags entropy over the observation window',\n"
"  min_delta_tsc: 'Worst-case (minimum) inter-packet timing entropy over the observation window',\n"
"  min_outer_src_ip: 'Worst-case (minimum) outer VXLAN source IP entropy over the observation window',\n"
"  min_outer_dst_ip: 'Worst-case (minimum) outer VXLAN destination IP entropy over the observation window',\n"
"  min_vni: 'Worst-case (minimum) VXLAN Network Identifier entropy over the observation window',\n"
"  min_total_5tuple: 'Aggregate sum of min-entropy for protocol, source/destination IP and port, packet size, and TCP flags; this is not joint 5-tuple entropy',\n"
"  distinct:     'Number of unique 5-tuple flows currently tracked in the connection table',\n"
"  ratio:        'Ratio of distinct flows to total packets — indicator of flow reuse vs churn',\n"
"  mi_sip_dip:   'I(Src IP; Dst IP) — correlation between source and destination selection',\n"
"  mi_spt_dpt:   'I(Src Port; Dst Port) — port-pair correlation; high = asymmetric services',\n"
"  mi_proto_spt: 'I(Protocol; Src Port) — protocol-port affinity; high = known service mapping',\n"
"  mi_size_dpt:  'I(Pkt Size; Dst Port) — service-specific payload sizes; high = each service uses distinct sizes',\n"
"  mi_size_proto:'I(Pkt Size; Protocol) — protocol-specific frame sizes; high = TCP vs UDP vs ICMP use different sizes',\n"
"  mi_dtsc_proto:'I(ΔTSC; Protocol) — per-protocol timing patterns; high = different protocols have distinct inter-arrival times',\n"
"  mi_dtsc_flow: 'I(ΔTSC; Flow Key) — temporal flow locality; high = packets of the same flow cluster in time (interleave=off); low = flows are temporally interleaved (interleave=on)',\n"
"  mi_tcpf_sz:  'I(TCP Flags; Pkt Size) — handshake vs data; high = SYN small, DATA large (normal TCP)',\n"
"  mi_tcpf_spt: 'I(TCP Flags; Src Port) — per-flow flag usage; high = different source ports use different flag patterns',\n"
"  mi_tcpf_dpt: 'I(TCP Flags; Dst Port) — service-specific flag patterns; high = port 80 all SYN, port 443 has FIN',\n"
"  mi_osip_odip:'I(Outer Src IP; Outer Dst IP) — VTEP pair affinity; high = tunnel endpoints are fixed pairs',\n"
"  psd_dominant: 'Lowest significant spectral peak supported by a harmonic series; falls back to the strongest peak',\n"
"  psd_flatness:  'Spectral flatness after removing mean TX rate, over non-DC bins -- 0 = tonal/periodic, 1 = noise-like variation',\n"
"  psd_resolution: 'Frequency resolution = Fs / N = 10000 Hz / 256 = 39.0625 Hz per bin; each bin index maps to index * 39.0625 Hz',\n"
"  mi_vni_osip: 'I(VNI; Outer Src IP) — VNI-to-VTEP mapping; high = each VNI is tied to one tunnel source',\n"
"};\n"
"\n"
