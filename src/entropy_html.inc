"\n"
"function tip(dimId) {\n"
"  const d = DESCS[dimId] || '';\n"
"  if (!d) return '';\n"
"  return '<span class=\"tip-icon\">?<span class=\"tip-box\">' + d + '</span></span>';\n"
"}\n"
"\n"
"function buildSection(section) {\n"
"  let h = '<div class=\"section-title\" id=\"title-' + section.id + '\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle\">▶</span>' + section.title + ' <span class=\"desc\">' + section.desc + '</span></span></div>';\n"
"  h += '<div class=\"section-body\" id=\"body-' + section.id + '\"><div class=\"grid\">';\n"
"  section.dims.forEach(d => {\n"
"    h += '<div class=\"card\" id=\"sec-' + section.id + '-' + d.id + '\">';\n"
"    h += '<div class=\"card-label\">' + d.label + tip(d.id) + '</div>';\n"
"    h += '<div class=\"card-value\"><span id=\"v-' + section.id + '-' + d.id + '\">--</span> <span class=\"unit\">/ <span id=\"max-' + section.id + '-' + d.id + '\">' + (d.max || '?') + '</span> bits</span></div>';\n"
"    h += '<div class=\"bar-track\"><div class=\"bar-fill l1\" id=\"b-' + section.id + '-' + d.id + '\" style=\"width:0%\"></div></div>';\n"
"    h += '</div>';\n"
"  });\n"
"  h += '</div></div>';\n"
"  return h;\n"
"}\n"
"\n"
"function buildMinSection() {\n"
"  let h = '<div class=\"grid\">';\n"
"  MIN_DIMS.forEach(d => {\n"
"    h += '<div class=\"card\" id=\"min-' + d.id + '\">';\n"
"    h += '<div class=\"card-label\">' + d.label + ' (min)' + tip(d.id) + '</div>';\n"
"    h += '<div class=\"card-value\"><span id=\"mv-' + d.id + '\">--</span> <span class=\"unit\">bits</span></div>';\n"
"    h += '<div class=\"card-value\"><span class=\"sub\" id=\"md-' + d.id + '\">waiting for evidence</span></div>';\n"
"    h += '</div>';\n"
"  });\n"
"  h += '</div>';\n"
"  return h;\n"
"}\n"
"\n"
"function minAction(id, state, surplusBits) {\n"
"  if (state === 'inactive') return 'Enable the corresponding traffic population.';\n"
"  if (state === 'insufficient-samples') return 'Collect at least 64 samples before acting.';\n"
"  if (state === 'good') return surplusBits > 0.0005\n"
"    ? 'Target exceeded by ' + surplusBits.toFixed(3) + ' bits; no action required.'\n"
"    : 'Target met; no action required.';\n"
"  if (id.includes('ip')) return 'Check address pool, worker coverage and interleave.';\n"
"  if (id.includes('port')) return 'Check port range, protocol mix and rotation.';\n"
"  if (id === 'protocol') return 'Check configured protocol weights and generation failures.';\n"
"  if (id === 'pkt_size') return 'Check IMIX entries, duplicates and packet construction failures.';\n"
"  if (id === 'tcp_flags') return 'Check TCP mode and handshake/data flag mix.';\n"
"  if (id === 'delta_tsc') return 'Check traffic model, pacing lateness and host noise.';\n"
"  if (id === 'vni') return 'Check VXLAN VNI pool and encapsulation ratio.';\n"
"  return 'Inspect the component dimensions with the largest gaps.';\n"
"}\n"
"\n"
"function renderMinInterpretation(diags) {\n"
"  const body = document.getElementById('min-interpretation-body');\n"
"  if (!body || !diags) return;\n"
"  const labels = Object.fromEntries(MIN_DIMS.map(d => [d.id.replace(/^min_/, ''), d.label]));\n"
"  const rows = Object.entries(diags).map(([id, d]) => ({ id, label: labels[id] || id, ...d }));\n"
"  const severity = { poor: 4, degraded: 3, 'insufficient-samples': 2, good: 1, inactive: 0 };\n"
"  rows.sort((a, b) => (severity[b.state] || 0) - (severity[a.state] || 0) ||\n"
"    (b.gap_bits || 0) - (a.gap_bits || 0));\n"
"  let h = '<table class=\"diag-table\"><thead><tr><th>Dimension</th><th>Measured</th><th>Window target</th>';\n"
"  h += '<th>Target comparison</th><th>Excess concentration</th><th>Evidence</th><th>State / Action</th></tr></thead><tbody>';\n"
"  rows.forEach(d => {\n"
"    const active = d.state !== 'inactive';\n"
"    const source = d.baseline_source === 'configured' ? 'cfg' : d.baseline_source;\n"
"    const measured = Number(d.measured);\n"
"    const target = Number(d.target);\n"
"    const populationTarget = Number(d.population_target);\n"
"    const shortfall = Number(d.gap_bits);\n"
"    const surplus = Math.max(0, measured - target);\n"
"    const comparison = shortfall > 0.0005\n"
"      ? 'Shortfall ' + shortfall.toFixed(3) + ' bits'\n"
"      : surplus > 0.0005 ? 'Met (+' + surplus.toFixed(3) + ' bits)' : 'Met';\n"
"    h += '<tr><td>' + d.label + '</td>';\n"
"    h += '<td>' + (active ? measured.toFixed(3) : '—') + '</td>';\n"
"    h += '<td>' + (active ? target.toFixed(3) + ' (' + source +\n"
"      (Number.isFinite(populationTarget) ? ', population ' + populationTarget.toFixed(3) : '') + ')' : '—') + '</td>';\n"
"    h += '<td>' + (active ? comparison : '—') + '</td>';\n"
"    h += '<td>' + (active ? (shortfall > 0.0005\n"
"      ? Number(d.dominance_ratio).toFixed(2) + '×'\n"
"      : '1.00× (none)') : '—') + '</td>';\n"
"    h += '<td>' + Number(d.samples || 0).toLocaleString() + ' samples';\n"
"    if (d.distinct) h += ', ' + Number(d.distinct).toLocaleString() + ' distinct';\n"
"    h += '</td><td><span class=\"diag-state ' + d.state + '\">' + d.state + '</span><br>';\n"
"    h += minAction(d.id, d.state, surplus) + '</td></tr>';\n"
"  });\n"
"  body.innerHTML = h + '</tbody></table>';\n"
"}\n"
"\n"
"function buildFlowExtra() {\n"
"  let h = '<div class=\"grid\">';\n"
