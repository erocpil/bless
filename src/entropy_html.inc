"</head>\n"
"<body>\n"
"<div class=\"toolbar\">\n"
"  <h1>🔥 Entropy</h1>\n"
"  <a href=\"/\">DPDK Stats</a>\n"
"  <a href=\"/entropy\" class=\"active\">Entropy</a>\n"
"  <a href=\"/observe\">Observe</a>\n"
"  <span id=\"conntxt\">Connecting...</span>\n"
"  <div class=\"status\">\n"
"    <span class=\"status-dot\" id=\"dot\"></span>\n"
"    <span id=\"statusText\">Disconnected</span>\n"
"    <span id=\"ts-last\" style=\"font-size: 12px;color:#484f58;margin-left:8px;\"></span>\n"
"  </div>\n"
"</div>\n"
"<div class=\"container\">\n"
"  <div id=\"toast\" style=\"display:none;position:fixed;top:10px;left:50%;transform:translateX(-50%);\n"
"    background:#da3633;color:#fff;padding:6px 16px;border-radius:4px;font-size: 14px;z-index:999;\n"
"    transition:opacity 0.5s;opacity:0;\"></div>\n"
"  <div id=\"content\">\n"
"    <div class=\"info\" id=\"waitmsg\">Waiting for data — start bless with handshake or mixed mode.</div>\n"
"  </div>\n"
"</div>\n"
"\n"
"<script>\n"
"let ws = null;\n"
"let reconnectTimer = null;\n"
"let lastDataTime = '';\n"
"let latestStats = null;\n"
"let renderPending = false;\n"
"let psdSmoothedBins = null;\n"
"let psdAssessmentState = '';\n"
"\n"
"function scheduleRender(data) {\n"
"  latestStats = data || latestStats;\n"
"  if (renderPending || !latestStats) return;\n"
"  renderPending = true;\n"
"  requestAnimationFrame(() => {\n"
"    renderPending = false;\n"
"    if (latestStats) render(latestStats);\n"
"  });\n"
"}\n"
"\n"
"function showToast(msg) {\n"
"  const el = document.getElementById('toast');\n"
"  if (!el) return;\n"
"  el.textContent = msg;\n"
"  el.style.opacity = 1;\n"
"  el.style.display = 'block';\n"
"  setTimeout(() => { el.style.opacity = 0; }, 3000);\n"
"}\n"
"\n"
"function updateReconnectCountdown(secs) {\n"
"  const txt = document.getElementById('conntxt');\n"
"  if (txt) txt.textContent = secs > 0 ? 'Reconnecting in ' + secs + 's…' : 'Disconnected';\n"
"}\n"
"\n"
"function scheduleReconnect(delayMs) {\n"
"  if (reconnectTimer) clearTimeout(reconnectTimer);\n"
"  const dot = document.getElementById('dot');\n"
"  const st  = document.getElementById('statusText');\n"
"  if (dot) dot.className = 'status-dot';\n"
"  if (st) st.textContent = 'Reconnecting…';\n"
"  let remaining = Math.round(delayMs / 1000);\n"
"  updateReconnectCountdown(remaining);\n"
"  const interval = setInterval(() => {\n"
"    remaining--;\n"
"    if (remaining > 0) updateReconnectCountdown(remaining);\n"
"    else clearInterval(interval);\n"
"  }, 1000);\n"
"  reconnectTimer = setTimeout(() => {\n"
"    clearInterval(interval);\n"
"    updateReconnectCountdown(0);\n"
"    connect();\n"
"  }, delayMs);\n"
"}\n"
"\n"
"function consumePageApiKey() {\n"
"  const query = new URLSearchParams(location.search);\n"
"  const fragment = new URLSearchParams(location.hash.replace(/^#/, ''));\n"
"  const apiKey = fragment.get('api_key') || query.get('api_key') || '';\n"
"  if (apiKey) {\n"
"    query.delete('api_key');\n"
"    fragment.delete('api_key');\n"
"    const clean = location.pathname +\n"
"      (query.toString() ? '?' + query.toString() : '') +\n"
"      (fragment.toString() ? '#' + fragment.toString() : '');\n"
"    history.replaceState(null, '', clean);\n"
"  }\n"
"  return apiKey;\n"
"}\n"
"\n"
"const pageApiKey = consumePageApiKey();\n"
"\n"
"function connect() {\n"
"  const protocol = (location.protocol === 'https:') ? 'wss://' : 'ws://';\n"
"  let extra = '';\n"
"  if (pageApiKey) extra = \"?api_key=\" + encodeURIComponent(pageApiKey);\n"
"  const url = protocol + location.host + '/wsURL' + extra;\n"
"  try {\n"
"    ws = new WebSocket(url);\n"
"    ws.onopen = () => {\n"
"      if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }\n"
"      document.getElementById('conntxt').style.display = 'none';\n"
"      document.getElementById('dot').className = 'status-dot on';\n"
"      document.getElementById('statusText').textContent = 'Connected';\n"
"      ws.send(JSON.stringify({ cmd: 'get' }));\n"
"    };\n"
"    ws.onmessage = e => {\n"
"      try {\n"
"        const data = JSON.parse(e.data);\n"
"        lastDataTime = new Date().toLocaleTimeString();\n"
"        if (document.getElementById('ts-last'))\n"
"          document.getElementById('ts-last').textContent = lastDataTime;\n"
"        if (data.entropy || data.handshake)\n"
"          scheduleRender(data);\n"
"        if (data.cmd === 'config')\n"
"          updateControlPanel(data);\n"
"      } catch (err) {\n"
"        console.error('Parse:', err);\n"
"      }\n"
"    };\n"
"    ws.onclose = () => {\n"
"      document.getElementById('dot').className = 'status-dot';\n"
"      scheduleReconnect(3000);\n"
"    };\n"
"    ws.onerror = () => {\n"
"      showToast('WebSocket connection error — retrying…');\n"
"    };\n"
"  } catch (err) {\n"
"    scheduleReconnect(3000);\n"
"  }\n"
"}\n"
"\n"
"// -- Dimension descriptions --\n"
"\n"
"const DESCS = {\n"
"  protocol:     'Distribution of IP protocol types (TCP, UDP, ICMP, etc.)',\n"
"  src_ip:       'Diversity of source IP addresses in generated traffic',\n"
"  dst_ip:       'Diversity of destination IP addresses in generated traffic',\n"
"  src_port:     'Variety of source port numbers used across flows',\n"
"  dst_port:     'Variety of destination port numbers targeted',\n"
"  joint_5tuple: 'Combined Shannon entropy across 5-tuple (proto + IPs + ports)',\n"
