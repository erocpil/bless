"}\n"
"\n"
"/* -- MI Matrix Heatmap -- */\n"
"\n"
"// 12 dimensions in display order\n"
"const MI_DIMS = [\n"
"  { id: 'protocol',     label: 'Protocol',   max: 8,   maxKey: '' },\n"
"  { id: 'src_ip',       label: 'Src IP',     max: 32,  maxKey: 'max_src_ip' },\n"
"  { id: 'dst_ip',       label: 'Dst IP',     max: 32,  maxKey: 'max_dst_ip' },\n"
"  { id: 'src_port',     label: 'Src Port',   max: 16,  maxKey: 'max_src_port' },\n"
"  { id: 'dst_port',     label: 'Dst Port',   max: 16,  maxKey: 'max_dst_port' },\n"
"  { id: 'pkt_size',     label: 'Pkt Size',   max: 16,  maxKey: '' },\n"
"  { id: 'tcp_flags',    label: 'TCP Flags',  max: 8,   maxKey: '' },\n"
"  { id: 'delta_tsc',    label: 'ΔTSC',       max: 64,  maxKey: '' },\n"
"  { id: 'outer_src_ip', label: 'O Src IP',   max: 32,  maxKey: 'max_outer_src_ip' },\n"
"  { id: 'outer_dst_ip', label: 'O Dst IP',   max: 32,  maxKey: 'max_outer_dst_ip' },\n"
"  { id: 'vni',          label: 'VNI',        max: 24,  maxKey: 'max_vni' },\n"
"  { id: 'flow_key',     label: 'Flow Key',  max: 32,  maxKey: '' },\n"
"];\n"
"\n"
"// MI pair lookup: matrix[row][col] = { miKey, miMaxKey, label } or null\n"
"const MI_MAP = {};\n"
"function miKey(r, c) {\n"
"  // Ensure lookup is symmetric: use canonical order (r < c)\n"
"  const a = r < c ? r : c;\n"
"  const b = r < c ? c : r;\n"
"  return a + '-' + b;\n"
"}\n"
"function setMI(r, c, miKeyName, miMaxKey, label) {\n"
"  const k = miKey(r, c);\n"
"  MI_MAP[k] = { miKey: miKeyName, miMaxKey: miMaxKey, label: label };\n"
"}\n"
"\n"
"setMI(0, 3, 'mi_proto_spt',  'mi_max_proto_spt',  'I(Protocol; Src Port)');\n"
"setMI(1, 2, 'mi_sip_dip',    'mi_max_sip_dip',    'I(Src IP; Dst IP)');\n"
"setMI(3, 4, 'mi_spt_dpt',    'mi_max_spt_dpt',    'I(Src Port; Dst Port)');\n"
"setMI(0, 5, 'mi_size_proto', 'mi_max_size_proto', 'I(Pkt Size; Protocol)');\n"
"setMI(4, 5, 'mi_size_dpt',   'mi_max_size_dpt',   'I(Pkt Size; Dst Port)');\n"
"setMI(0, 7, 'mi_dtsc_proto', 'mi_max_dtsc_proto', 'I(ΔTSC; Protocol)');\n"
"setMI(7, 11,'mi_dtsc_flow', 'mi_max_dtsc_flow',  'I(ΔTSC; Flow Key) — temporal flow locality');\n"
"setMI(5, 6, 'mi_tcpf_sz',    'mi_max_tcpf_sz',    'I(TCP Flags; Pkt Size)');\n"
"setMI(3, 6, 'mi_tcpf_spt',   'mi_max_tcpf_spt',   'I(TCP Flags; Src Port)');\n"
"setMI(4, 6, 'mi_tcpf_dpt',   'mi_max_tcpf_dpt',   'I(TCP Flags; Dst Port)');\n"
"setMI(8, 9, 'mi_osip_odip',  'mi_max_osip_odip',  'I(Outer Src; Outer Dst)');\n"
"setMI(8, 10,'mi_vni_osip',   'mi_max_vni_osip',   'I(VNI; Outer Src IP)');\n"
"\n"
"function heatBg(val, max, isDiag) {\n"
"  const ratio = Math.min(1, max > 0 ? val / max : 0);\n"
"  if (ratio <= 0.001) return isDiag ? 'background:#0d1117' : 'background:#0d1f1d';\n"
"  const l = 10 + ratio * 38;\n"
"  if (isDiag) {\n"
"    // Blue gradient for diagonal (entropy)\n"
"    const s = 70 + ratio * 20;\n"
"    return 'background:hsl(210,' + s.toFixed(0) + '%,' + l.toFixed(0) + '%)';\n"
"  } else {\n"
"    // Green gradient for off-diagonal (MI)\n"
"    const s = 45 + ratio * 35;\n"
"    return 'background:hsl(155,' + s.toFixed(0) + '%,' + l.toFixed(0) + '%)';\n"
"  }\n"
"}\n"
"\n"
"function buildMIMatrix() {\n"
"  const N = MI_DIMS.length;\n"
"  let h = '<div class=\"section-title\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle\">▶</span>MI Correlation Matrix <span class=\"desc\">12×12 heatmap — hover for values</span></span></div>';\n"
"  h += '<div class=\"section-body\" id=\"body-mi\"><div class=\"matrix-wrap\"><div class=\"matrix-grid\" id=\"mi-grid\">';\n"
"\n"
"  // Corner + column headers\n"
"  h += '<div class=\"matrix-lbl\" style=\"color:#484f58;font-size: 9px;justify-content:center;\">X\\\\Y</div>';\n"
"  for (let c = 0; c < N; c++) {\n"
"    h += '<div class=\"matrix-lbl col\" style=\"grid-row:1;grid-column:' + (c + 2) + ';\">' + MI_DIMS[c].label + '</div>';\n"
"  }\n"
"\n"
"  // Rows\n"
"  for (let r = 0; r < N; r++) {\n"
"    // Row label\n"
"    h += '<div class=\"matrix-lbl\" style=\"grid-row:' + (r + 2) + ';grid-column:1;\">' + MI_DIMS[r].label + '</div>';\n"
"    for (let c = 0; c < N; c++) {\n"
"      const cellId = 'mc-' + r + '-' + c;\n"
"      if (r === c) {\n"
"        // Diagonal: placeholder entropy value\n"
"        h += '<div class=\"matrix-cell\" id=\"' + cellId + '\" style=\"grid-row:' + (r + 2) + ';grid-column:' + (c + 2) + ';background:#161b22;\"><span id=\"' + cellId + '-v\">-</span></div>';\n"
"      } else {\n"
"        const entry = MI_MAP[miKey(r, c)];\n"
"        if (entry) {\n"
"          // MI pair cell - choose tooltip direction based on column\n"
"          let tipClass = '';\n"
"          if (c >= N - 3) tipClass = ' tip-right';\n"
"          else if (c <= 0) tipClass = ' tip-left';\n"
"          h += '<div class=\"matrix-cell\" id=\"' + cellId + '\" style=\"grid-row:' + (r + 2) + ';grid-column:' + (c + 2) + ';background:#0d1f1d;\"><span id=\"' + cellId + '-v\">-</span><div class=\"tip' + tipClass + '\" id=\"' + cellId + '-tip\"></div></div>';\n"
"        } else {\n"
"          // No MI computed\n"
"          h += '<div class=\"matrix-cell nodata\" id=\"' + cellId + '\" style=\"grid-row:' + (r + 2) + ';grid-column:' + (c + 2) + ';\">-</div>';\n"
"        }\n"
"      }\n"
"    }\n"
"  }\n"
"  h += '</div></div>';\n"
"\n"
"  // Legend\n"
"  h += '<div class=\"matrix-legend\">';\n"
"  h += '<span style=\"color:#f0f6fc;\">■</span> 0.0';\n"
"  for (let i = 1; i <= 10; i++) {\n"
"    const pct = (i / 10) * 100;\n"
"    const l = 10 + (i / 10) * 38;\n"
"    h += '<div class=\"swatch\" style=\"background:hsl(155,65%,' + l.toFixed(0) + '%);\"></div>';\n"
"  }\n"
"  h += ' max&nbsp;&nbsp;<span style=\"color:#58a6ff;\">■</span> diag (entropy)';\n"
"  h += '<div class=\"swatch\" style=\"background:hsl(210,80%,48%);\"></div>';\n"
"  h += '<span class=\"sep\">|</span><span style=\"color:#30363d;\">■</span> no data';\n"
"  h += '</div>';\n"
"\n"
"  h += '</div>'; // close section-body\n"
"  return h;\n"
"}\n"
"\n"
"/* -- MI Card Details (collapsed by default) -- */\n"
"\n"
"function buildMICards() {\n"
"  const pairs = [\n"
"    { id: 'mi_sip_dip',   label: 'I(Src IP; Dst IP)',       max: 16 },\n"
"    { id: 'mi_spt_dpt',   label: 'I(Src Port; Dst Port)',   max: 8 },\n"
"    { id: 'mi_proto_spt', label: 'I(Protocol; Src Port)',   max: 6 },\n"
"    { id: 'mi_size_dpt',  label: 'I(Pkt Size; Dst Port)',   max: 16 },\n"
"    { id: 'mi_size_proto',label: 'I(Pkt Size; Protocol)',   max: 8 },\n"
"    { id: 'mi_dtsc_proto',label: 'I(ΔTSC; Protocol)',       max: 8 },\n"
"    { id: 'mi_dtsc_flow', label: 'I(ΔTSC; Flow Key)',      max: 16 },\n"
"    { id: 'mi_tcpf_sz',   label: 'I(TCP Flags; Pkt Size)',  max: 8 },\n"
"    { id: 'mi_tcpf_spt',  label: 'I(TCP Flags; Src Port)',  max: 8 },\n"
"    { id: 'mi_tcpf_dpt',  label: 'I(TCP Flags; Dst Port)',  max: 8 },\n"
"    { id: 'mi_osip_odip', label: 'I(Outer Src; Outer Dst)', max: 16 },\n"
"    { id: 'mi_vni_osip',  label: 'I(VNI; Outer Src IP)',    max: 16 },\n"
"  ];\n"
"  let h = '<div class=\"section-title\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle folded\">▶</span>MI Details <span class=\"desc\">per-pair values with tooltip & theoretical max</span></span></div>';\n"
"  h += '<div class=\"section-body folded\" id=\"body-mi-cards\"><div class=\"grid\">';\n"
"  pairs.forEach(p => {\n"
"    h += '<div class=\"card\" id=\"mic-' + p.id + '\">';\n"
"    h += '<div class=\"card-label\">' + p.label + tip(p.id) + '</div>';\n"
"    h += '<div class=\"card-value\"><span id=\"mcv-' + p.id + '\">--</span> <span class=\"unit\">/ ' + p.max + ' bits<span id=\"mcc-' + p.id + '\" class=\"cfg-max\"></span></span></div>';\n"
"    h += '<div class=\"bar-track\"><div class=\"bar-fill l2\" id=\"mcb-' + p.id + '\" style=\"width:0%\"></div></div>';\n"
"    h += '</div>';\n"
"  });\n"
"  h += '</div></div>';\n"
"  return h;\n"
"}\n"
"\n"
"/* -- Runtime Control Panel -- */\n"
"\n"
"const CTRL_PARAMS = [\n"
"  {\n"
"    title: 'Rate Limiting',\n"
"    items: [\n"
"      { key: 'pps_rate',     label: 'PPS Rate',   unit: 'pkt/s', fmt: 'int', suffix: true },\n"
"      { key: 'pps_burst',    label: 'PPS Burst',  unit: 'pkt',   fmt: 'int', suffix: true },\n"
"      { key: 'bps_rate',     label: 'BPS Rate',   unit: 'bit/s', fmt: 'int', suffix: true },\n"
"      { key: 'bps_burst',    label: 'BPS Burst',  unit: 'bit',   fmt: 'int', suffix: true },\n"
"    ]\n"
"  },\n"
"  {\n"
"    title: 'Traffic',\n"
"    items: [\n"
"      { key: 'batch',           label: 'Batch',          unit: 'pkt',   fmt: 'int' },\n"
"      { key: 'batch_delay_us',  label: 'Delay',          unit: 'µs',    fmt: 'int' },\n"
"      { key: 'batch_jitter_us', label: 'Jitter',         unit: 'µs',    fmt: 'int' },\n"
"      { key: 'num',             label: 'Pkt Count',      unit: '-1=inf',fmt: 'int' },\n"
"      { key: 'traffic_model',   label: 'Traffic Model',  unit: '0=fixed,1=poisson', fmt: 'int' },\n"
"      { key: 'sample_interval', label: 'Sample Interval',unit: 'pkt',   fmt: 'int' },\n"
"    ]\n"
"  },\n"
"  {\n"
"    title: 'Entropy',\n"
"    items: [\n"
"      { key: 'entropy_target',      label: 'Target',     unit: 'bit',   fmt: 'float' },\n"
"      { key: 'entropy_dim',         label: 'Dimension',  unit: '',      fmt: 'int' },\n"
"      { key: 'entropy_adapt_gain',  label: 'Adapt Gain', unit: '',      fmt: 'float' },\n"
"    ]\n"
"  },\n"
"  {\n"
"    title: 'Handshake',\n"
"    items: [\n"
"      { key: 'hs_rate',        label: 'HS Rate',        unit: 'conn/s', fmt: 'int', suffix: true },\n"
"      { key: 'hs_timeout_us',  label: 'HS Timeout',     unit: 'µs',     fmt: 'int' },\n"
"      { key: 'hs_mix_ratio',   label: 'HS Mix Ratio',   unit: '0-1000', fmt: 'int' },\n"
"    ]\n"
"  },\n"
"];\n"
"\n"
"function buildControlPanel() {\n"
"  let h = '<div class=\"section-title\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle folded\">▶</span>Runtime Control <span class=\"desc\">adjust parameters via WebSocket</span></span></div>';\n"
"  h += '<div class=\"section-body folded\" id=\"body-ctrl\">';\n"
"  h += '<div class=\"ctrl-toolbar\">';\n"
"  h += '<button class=\"btn\" onclick=\"sendGet()\">⟳ Refresh All</button>';\n"
"  h += '<span class=\"status\" id=\"ctrl-status\"></span>';\n"
"  h += '</div>';\n"
"  h += '<div class=\"ctrl-grid\">';\n"
"  CTRL_PARAMS.forEach(group => {\n"
"    h += '<div class=\"ctrl-group\">';\n"
"    h += '<div class=\"head\">' + group.title + '</div>';\n"
"    group.items.forEach(item => {\n"
"      const id = 'ctrl-' + item.key;\n"
"      h += '<div class=\"ctrl-row\">';\n"
"      h += '<span class=\"lbl\">' + item.label + '</span>';\n"
"      h += '<span class=\"cur\" id=\"cv-' + item.key + '\">--</span>';\n"
"      h += '<span class=\"unit\" style=\"font-size: 10px;color:#484f58;min-width:40px;\">' + item.unit + '</span>';\n"
"      h += '<input type=\"text\" id=\"ci-' + item.key + '\" placeholder=\"e.g. 100K\">';\n"
"      h += '<button class=\"btn\" onclick=\"sendSet(\\'' + item.key + '\\')\">Set</button>';\n"
"      h += '</div>';\n"
"    });\n"
"    h += '</div>';\n"
"  });\n"
"  h += '</div></div>';\n"
"  return h;\n"
"}\n"
"\n"
"function parseRateValue(key, raw) {\n"
"  /* Check if this key accepts rate suffixes */\n"
"  const item = CTRL_PARAMS.flatMap(g => g.items).find(i => i.key === key);\n"
"  if (!item || !item.suffix) return Number(raw);\n"
"  /* Parse suffixes: 100K, 1.5M, 10G */\n"
"  const m = raw.match(/^([\\d.]+)\\s*([kKmMgG]?)([bB]?)$/);\n"
"  if (!m) return Number(raw);\n"
"  const num = parseFloat(m[1]);\n"
"  const suf = m[2].toUpperCase();\n"
"  const mult = suf === 'K' ? 1000 : suf === 'M' ? 1000000 : suf === 'G' ? 1000000000 : 1;\n"
"  return Math.round(num * mult);\n"
"}\n"
"\n"
"function sendSet(key) {\n"
"  const el = document.getElementById('ci-' + key);\n"
"  if (!el || !ws) return;\n"
"  const raw = el.value.trim();\n"
"  if (!raw) return;\n"
"  const numVal = parseRateValue(key, raw);\n"
"  ws.send(JSON.stringify({ cmd: 'set', key: key, value: numVal }));\n"
"  document.getElementById('ctrl-status').textContent = 'set ' + key + '=' + numVal;\n"
"}\n"
"\n"
"function sendGet() {\n"
"  if (!ws) return;\n"
"  ws.send(JSON.stringify({ cmd: 'get' }));\n"
"  document.getElementById('ctrl-status').textContent = 'querying...';\n"
"}\n"
"\n"
"function updateControlPanel(config) {\n"
"  if (!config || config.cmd !== 'config') return;\n"
"  CTRL_PARAMS.forEach(group => {\n"
"    group.items.forEach(item => {\n"
"      const val = config[item.key];\n"
"      if (val === undefined) return;\n"
"      const el = document.getElementById('cv-' + item.key);\n"
"      if (el) el.textContent = item.fmt === 'float' ? Number(val).toFixed(3) : val;\n"
"    });\n"
"  });\n"
"  document.getElementById('ctrl-status').textContent = 'updated at ' + new Date().toLocaleTimeString();\n"
"}\n"
"\n"
"function buildHandshake() {\n"
"  const items = [\n"
"    { id: 'cps', label: 'CPS', cls: 'highlight', fmt: v => (v || 0).toFixed(0) },\n"
"    { id: 'syn_sent', label: 'SYN Sent', fmt: v => (v || 0).toLocaleString() },\n"
"    { id: 'established', label: 'Established', fmt: v => (v || 0).toLocaleString() },\n"
"    { id: 'conn_current', label: 'Active Conn', fmt: v => (v || 0).toLocaleString() },\n"
"    { id: 'conn_max', label: 'Max Conn', fmt: v => (v || 0).toLocaleString() },\n"
"    { id: 'timed_out', label: 'Timed Out', fmt: v => (v || 0).toLocaleString() },\n"
"    { id: 'success_rate', label: 'Success Rate', fmt: v => ((v || 0) * 100).toFixed(1) + '%' },\n"
"    { id: 'rst_sent', label: 'RST Sent', fmt: v => (v || 0).toLocaleString() },\n"
"  ];\n"
"  let h = '<div class=\"hs-row\" id=\"hs-row\">';\n"
"  items.forEach(item => {\n"
"    h += '<div class=\"hs-stat ' + (item.cls || '') + '\" id=\"hs-' + item.id + '\">';\n"
"    h += '<div class=\"val\" id=\"hv-' + item.id + '\">--</div>';\n"
"    h += '<div class=\"lbl\">' + item.label + '</div></div>';\n"
"  });\n"
"  h += '</div>';\n"
"  return h;\n"
"}\n"
"\n"
"// -- Build all sections once, then update incrementally --\n"
"\n"
"function initDOM() {\n"
"  const container = document.getElementById('content');\n"
"  let h = '<div id=\"hs-section\" style=\"display:none\">';\n"
"  h += '<div class=\"section-title\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle\">▶</span>TCP Handshake</span></div>';\n"
"  h += '<div class=\"section-body\" id=\"body-handshake\">' + buildHandshake() + '</div>';\n"
"  h += '</div>';\n"
"\n"
"  h += '<div class=\"section-title\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle\">▶</span>Min-Entropy <span class=\"desc\">worst-case</span></span></div>';\n"
"  h += '<div class=\"section-body\" id=\"body-min\">' + buildMinSection();\n"
"  h += '<div class=\"section-title\" id=\"title-min-interpretation\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle\">▶</span>Interpretation <span class=\"desc\">configuration-aware min-entropy gaps, ranked by severity</span></span></div>';\n"
"  h += '<div class=\"section-body interpretation-content\" id=\"min-interpretation-body\"></div>';\n"
"  h += '</div>';\n"
"\n"
"  h += buildMIMatrix();\n"
"\n"
"  h += buildMICards();\n"
"\n"
"  CATEGORIES.forEach(cat => { h += buildSection(cat); });\n"
"\n"
"  h += '<div class=\"section-title\" id=\"title-flow-extra\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle\">▶</span>Flow Details <span class=\"desc\">tracking stats</span></span></div>';\n"
"  h += '<div class=\"section-body\" id=\"body-flow-extra\"><div id=\"flow-extra-section\">' + buildFlowExtra() + '</div></div>';\n"
"\n"
"  h += buildControlPanel();\n"
"\n"
"  // -- Rate PSD section (256-point FFT spectrum) --\n"
"\n"
"  h += '<div class=\"section-title\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle\">\\u25b6</span>Rate PSD <span class=\"desc\">frequency-domain TX rate analysis, 256-pt FFT, 39.06 Hz/bin</span></span></div>';\n"
"  h += '<div class=\"section-body\" id=\"body-psd\">';\n"
"  h += '<div class=\"grid\">';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">Fundamental Freq';\n"
"  h += tip('psd_dominant') + '</div><div class=\"card-value\"><span id=\"psd-fundamental\">--</span> <span class=\"unit\">Hz</span></div></div>';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">Strongest Peak</div><div class=\"card-value\"><span id=\"psd-strongest\">--</span> <span class=\"unit\">Hz</span></div></div>';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">Spectral Flatness';\n"
"  h += tip('psd_flatness') + '</div><div class=\"card-value\"><span id=\"psd-flatness\">--</span></div></div>';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">Resolution';\n"
"  h += tip('psd_resolution') + '</div><div class=\"card-value\">39.06 <span class=\"unit\">Hz/bin</span></div></div>';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">Pacing Freq</div><div class=\"card-value\"><span id=\"psd-pacing-freq\">--</span> <span class=\"unit\">Hz</span></div></div>';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">Submit Overshoot P99</div><div class=\"card-value\"><span id=\"psd-submit-p99\">--</span> <span class=\"unit\">&micro;s</span></div></div>';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">TX Burst P99</div><div class=\"card-value\"><span id=\"psd-burst-p99\">--</span> <span class=\"unit\">&micro;s</span></div></div>';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">Mean TX Rate</div><div class=\"card-value\"><span id=\"psd-mean-rate\">--</span> <span class=\"unit\">Kpps</span></div></div>';\n"
"  h += '<div class=\"card\"><div class=\"card-label\">Rate Variation (RMS)</div><div class=\"card-value\"><span id=\"psd-variation-rms\">--</span> <span class=\"unit\">Kpps</span></div></div>';\n"
"  h += '</div>';\n"
"  h += '<div class=\"section-title\"><span class=\"flex-title\" onclick=\"toggleSection(this)\">';\n"
"  h += '<span class=\"collapse-toggle\">\\u25b6</span>Interpretation <span class=\"desc\">how to read the PSD spectrum</span></span></div>';\n"
"  h += '<div class=\"section-body interpretation-content\">';\n"
"  h += '<div style=\"font-size:12px;color:#8b949e;line-height:1.55;\">';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Assessment states</b> &mdash; the current state is highlighted.</p>';\n"
"  h += '<div class=\"psd-assessment-list\">';\n"
"  h += '<div class=\"psd-assessment-item\" id=\"psd-assessment-idle\"><b>No samples</b> &mdash; TX is idle or no TX worker is available.</div>';\n"
"  h += '<div class=\"psd-assessment-item\" id=\"psd-assessment-stable\"><b>Stable TX</b> &mdash; mean rate only; no non-DC variation is detected.</div>';\n"
"  h += '<div class=\"psd-assessment-item\" id=\"psd-assessment-strong-periodic\"><b>Strong periodic</b> &mdash; flatness &lt; 0.1; compare peaks with pacing and shaping cycles.</div>';\n"
"  h += '<div class=\"psd-assessment-item\" id=\"psd-assessment-structured\"><b>Structured</b> &mdash; flatness 0.1&ndash;0.4; inspect pacing, batching, and policers.</div>';\n"
"  h += '<div class=\"psd-assessment-item\" id=\"psd-assessment-mixed\"><b>Mixed</b> &mdash; flatness 0.4&ndash;0.7; check whether peaks persist across windows.</div>';\n"
"  h += '<div class=\"psd-assessment-item\" id=\"psd-assessment-broadband\"><b>Broadband</b> &mdash; flatness &ge; 0.7; no strong periodic structure is evident.</div>';\n"
"  h += '</div>';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Sampling</b> &mdash; TX rate sampled at 10 kHz (100 &micro;s bins) over a 256-point Hann-windowed FFT.</p>';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Chart</b> &mdash; mean TX rate is removed before the FFT; bars show bins 1&ndash;127 on a 0 to &minus;80 dB scale. DC (bin 0) is excluded from all PSD diagnostics.</p>';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Pacing Freq</b> &mdash; reciprocal of the effective TX submit interval. Orange lines mark the fundamental and its harmonics within the chart range. A peak cut off near 5 kHz reaches the 100 &micro;s sampler\\'s Nyquist limit. Displayed bins use light temporal smoothing; numeric diagnostics use the unsmoothed spectrum.</p>';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Pacing Timing</b> &mdash; Submit Overshoot measures how late software reaches a deadline, before calling the PMD. TX Burst measures time spent inside rte_eth_tx_burst(). Neither is wire-departure latency.</p>';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Fundamental Freq</b> &mdash; lowest significant peak supported by a harmonic-series peak. If no series is found, it falls back to the strongest peak.</p>';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Strongest Peak</b> &mdash; highest-power non-DC bin; for narrow TX pulses this can be a harmonic rather than the repetition rate.</p>';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Spectral Flatness</b> &mdash; Wiener entropy: geometric mean / arithmetic mean of bin magnitudes. 0 = pure periodic tone (single bin dominates), 1 = uniform white noise (all bins equal).</p>';\n"
"  h += '<p style=\"margin:3px 0;\"><b style=\"color:#c9d1d9;\">Diagnosis</b> &mdash; broad, flat spectra signal high TX entropy (ideal for hash/ECMP stress testing). Sharp peaks reveal periodic structure from DUT token-bucket or policer cycles (indicates rate-limit saturation).</p>';\n"
"  h += '</div>';\n"
"  h += '</div>';\n"
"  h += '<div style=\"background:#161b22;border:1px solid #30363d;border-radius:6px;padding:10px;position:relative;\">';\n"
"  h += '<canvas id=\"psd-canvas\" style=\"width:100%;height:230px;\"></canvas>';\n"
"  h += '</div>';\n"
"  h += '</div>';\n"
"\n"
"  container.innerHTML = h;\n"
"}\n"
"\n"
"function toggleSection(el) {\n"
"  const body = el.parentElement.nextElementSibling;\n"
"  if (!body || !body.classList) return;\n"
"  const toggle = el.querySelector('.collapse-toggle');\n"
"  body.classList.toggle('folded');\n"
"  toggle.classList.toggle('folded');\n"
"  if (!body.classList.contains('folded')) scheduleRender();\n"
"}\n"
"\n"
"function sectionExpanded(id) {\n"
"  const el = document.getElementById(id);\n"
"  return !!el && !el.classList.contains('folded') && el.style.display !== 'none';\n"
"}\n"
"\n"
"function updateValue(id, text) {\n"
"  const el = document.getElementById(id);\n"
"  if (el) el.textContent = text;\n"
"}\n"
"\n"
"function updateBar(id, pct) {\n"
"  const el = document.getElementById(id);\n"
"  if (el) el.style.width = Math.min(100, pct) + '%';\n"
"}\n"
"\n"
"// -- Update values incrementally (no DOM rebuild) --\n"
"\n"
"function render(data) {\n"
"  const e = data.entropy || {};\n"
"  const hs = data.handshake || {};\n"
"\n"
"  const container = document.getElementById('content');\n"
"  if (!container._init) {\n"
"    initDOM();\n"
"    container._init = true;\n"
"  }\n"
"\n"
"  // Handshake section\n"
"  const hsSection = document.getElementById('hs-section');\n"
"  if (hs.syn_sent !== undefined) {\n"
"    hsSection.style.display = '';\n"
"    if (sectionExpanded('body-handshake')) {\n"
"      const updates = ['cps', 'syn_sent', 'established', 'conn_current', 'conn_max', 'timed_out', 'rst_sent'];\n"
"      updates.forEach(k => {\n"
"        updateValue('hv-' + k, (hs[k] || 0).toLocaleString());\n"
"      });\n"
"      updateValue('hv-success_rate', ((hs.success_rate || 0) * 100).toFixed(1) + '%');\n"
"    }\n"
"  } else {\n"
"    hsSection.style.display = 'none';\n"
"  }\n"
"\n"
"  // Entropy dimensions\n"
"  const allDims = [];\n"
"  CATEGORIES.forEach(cat => {\n"
"    if (!sectionExpanded('body-' + cat.id)) return;\n"
"    cat.dims.forEach(d => {\n"
"      allDims.push({ id: d.id, max: d.max, maxKey: d.maxKey, cat: cat.id, key: d.key || d.id });\n"
"    });\n"
"  });\n"
"  allDims.forEach(d => {\n"
"    const val = e[d.key];\n"
"    if (val === undefined) return;\n"
"    updateValue('v-' + d.cat + '-' + d.id, val.toFixed(3));\n"
"    const configuredMax = d.maxKey && e[d.maxKey] > 0 ? e[d.maxKey] : d.max;\n"
"    updateValue('max-' + d.cat + '-' + d.id, Number(configuredMax).toFixed(2));\n"
"    const pct = configuredMax > 0 ? (val / configuredMax) * 100 : 0;\n"
"    updateBar('b-' + d.cat + '-' + d.id, pct);\n"
"  });\n"
"\n"
"  // Min entropy\n"
"  if (sectionExpanded('body-min')) {\n"
"    MIN_DIMS.forEach(d => {\n"
"      const val = e[d.id];\n"
"      if (val === undefined) return;\n"
"      updateValue('mv-' + d.id, val.toFixed(3));\n"
"    });\n"
"  }\n"
"\n"
"  if (e.min_diagnostics && sectionExpanded('body-min')) {\n"
"    Object.entries(e.min_diagnostics).forEach(([id, d]) => {\n"
"      const key = 'min_' + id;\n"
"      const card = document.getElementById('min-' + key);\n"
"      if (card) {\n"
"        card.className = 'card diag-' + d.state;\n"
"        const measured = Number(d.measured);\n"
"        const target = Number(d.target);\n"
"        const shortfall = Number(d.gap_bits);\n"
"        const surplus = Math.max(0, measured - target);\n"
"        const comparison = shortfall > 0.0005\n"
"          ? 'shortfall ' + shortfall.toFixed(3) + ' bits'\n"
"          : surplus > 0.0005 ? 'met, +' + surplus.toFixed(3) + ' bits' : 'met';\n"
"        const detail = d.state === 'inactive' ? 'inactive' :\n"
"          'window target ' + target.toFixed(3) + ', ' + comparison;\n"
"        updateValue('md-' + key, detail);\n"
"      }\n"
"    });\n"
"  }\n"
"  if (e.min_diagnostics && sectionExpanded('min-interpretation-body'))\n"
"    renderMinInterpretation(e.min_diagnostics);\n"
"\n"
"  // Flow extra\n"
"  const flowActive = hs.syn_sent !== undefined;\n"
"  const flowTitle = document.getElementById('title-flow');\n"
"  const flowBody = document.getElementById('body-flow');\n"
"  [flowTitle, flowBody].forEach(el => {\n"
"    if (el) el.style.display = flowActive ? '' : 'none';\n"
"  });\n"
"  if (flowActive && sectionExpanded('body-flow') && e.flow_entropy_5tuple !== undefined) {\n"
"    updateValue('v-flow-flow_5tuple', e.flow_entropy_5tuple.toFixed(3));\n"
"    updateBar('b-flow-flow_5tuple', (e.flow_entropy_5tuple / 64) * 100);\n"
"  }\n"
"  if (flowActive && sectionExpanded('body-flow') && e.flow_entropy_lifetime !== undefined) {\n"
"    updateValue('v-flow-flow_lifetime', e.flow_entropy_lifetime.toFixed(3));\n"
"    updateBar('b-flow-flow_lifetime', (e.flow_entropy_lifetime / 64) * 100);\n"
"  }\n"
"  if (sectionExpanded('body-flow-extra') && e.flow_distinct !== undefined) {\n"
"    updateValue('fv-distinct', (e.flow_distinct || 0).toLocaleString());\n"
"    updateValue('fv-distinct-total', 'of ' + (e.flow_total || 0).toLocaleString() + ' total');\n"
"  }\n"
"  if (sectionExpanded('body-flow-extra') && e.flow_ratio !== undefined) {\n"
"    updateValue('fv-ratio', (e.flow_ratio * 100).toFixed(1));\n"
"    updateBar('fb-ratio', e.flow_ratio * 100);\n"
"  }\n"
"  if (sectionExpanded('body-flow-extra') && e.sampler_samples !== undefined)\n"
"    updateValue('fv-sampler-samples', Number(e.sampler_samples).toLocaleString());\n"
"  if (sectionExpanded('body-flow-extra') && e.sampler_overwritten_window !== undefined) {\n"
"    updateValue('fv-sampler-overwritten', Number(e.sampler_overwritten_window).toLocaleString());\n"
"    updateValue('fv-sampler-overwritten-total',\n"
"      'of ' + Number(e.sampler_overwritten || 0).toLocaleString() + ' total');\n"
"  }\n"
"\n"
"  // -- Rate PSD Update --\n"
"\n"
"  const psd = data.psd || {};\n"
"  const observe = data.observe || {};\n"
"\n"
"  if (sectionExpanded('body-psd') && psd.bins && psd.bins.length) {\n"
"    updateValue('psd-fundamental', (psd.fundamental_hz || psd.dominant_hz || 0).toFixed(1));\n"
"    updateValue('psd-strongest', (psd.strongest_peak_hz || psd.dominant_hz || 0).toFixed(1));\n"
"    updateValue('psd-flatness', (psd.spectral_flatness || 0).toFixed(4));\n"
"    updateValue('psd-mean-rate', (Number(psd.mean_ppms) || 0).toFixed(2));\n"
"    updateValue('psd-variation-rms', (Number(psd.variation_rms_ppms) || 0).toFixed(3));\n"
"    const targetUs = Number(observe.tx_submit_target_us) || 0;\n"
"    const pacingHz = targetUs > 0 ? 1000000 / targetUs : 0;\n"
"    updateValue('psd-pacing-freq', pacingHz > 0 ? pacingHz.toFixed(1) : '--');\n"
"    updateValue('psd-submit-p99',\n"
"      (Number(observe.tx_submit_overshoot_p99_us) || 0).toFixed(2));\n"
"    updateValue('psd-burst-p99',\n"
"      (Number(observe.tx_burst_duration_p99_us) || 0).toFixed(2));\n"
"\n"
"    const signalPower = psd.bins.slice(1, 128).reduce((sum, v) =>\n"
"      sum + (Number.isFinite(Number(v)) && Number(v) > 0 ? Number(v) : 0), 0);\n"
"    const signalValid = psd.signal_valid !== undefined\n"
"      ? Boolean(psd.signal_valid) : signalPower > 1e-15;\n"
"    const flatness = Number(psd.spectral_flatness) || 0;\n"
"    let assessmentState;\n"
"    if (!signalValid && (Number(psd.mean_ppms) || 0) > 0) {\n"
"      assessmentState = 'stable';\n"
"    } else if (!signalValid) {\n"
"      assessmentState = 'idle';\n"
"    } else if (flatness < 0.1) {\n"
"      assessmentState = 'strong-periodic';\n"
"    } else if (flatness < 0.4) {\n"
"      assessmentState = 'structured';\n"
"    } else if (flatness < 0.7) {\n"
"      assessmentState = 'mixed';\n"
"    } else {\n"
"      assessmentState = 'broadband';\n"
"    }\n"
"    if (assessmentState !== psdAssessmentState) {\n"
"      document.querySelectorAll('.psd-assessment-item.active').forEach(el =>\n"
"        el.classList.remove('active'));\n"
"      const current = document.getElementById('psd-assessment-' + assessmentState);\n"
"      if (current) current.classList.add('active');\n"
"      psdAssessmentState = assessmentState;\n"
"    }\n"
"\n"
"    const canvas = document.getElementById('psd-canvas');\n"
"    if (canvas) {\n"
"      const ctx = canvas.getContext('2d');\n"
"      const W = canvas.parentElement.clientWidth - 20;\n"
"      const H = 230;\n"
"      const dpr = window.devicePixelRatio || 1;\n"
"      canvas.width = W * dpr;\n"
"      canvas.height = H * dpr;\n"
"      canvas.style.width = W + 'px';\n"
"      canvas.style.height = H + 'px';\n"
"      ctx.scale(dpr, dpr);\n"
"\n"
"      const rawBins = psd.bins.slice(1, 128).map(v =>\n"
"        Number.isFinite(Number(v)) && Number(v) > 0 ? Number(v) : 0);\n"
"      if (!signalValid || !psdSmoothedBins ||\n"
"          psdSmoothedBins.length !== rawBins.length) {\n"
"        psdSmoothedBins = rawBins.slice();\n"
"      } else {\n"
"        const alpha = 0.25;\n"
"        for (let i = 0; i < rawBins.length; i++)\n"
"          psdSmoothedBins[i] += alpha * (rawBins[i] - psdSmoothedBins[i]);\n"
"      }\n"
"      const bins = psdSmoothedBins;\n"
"      let maxVal = 0;\n"
"      for (let i = 0; i < bins.length; i++) { if (bins[i] > maxVal) maxVal = bins[i]; }\n"
"      const barW = W / bins.length;\n"
"      const chartH = H - 25;\n"
"      ctx.clearRect(0, 0, W, H);\n"
"\n"
"      if (maxVal === 0) {\n"
"        ctx.fillStyle = '#8b949e';\n"
"        ctx.font = '12px monospace';\n"
"        ctx.textAlign = 'center';\n"
"        ctx.fillText((Number(psd.mean_ppms) || 0) > 0\n"
"          ? 'Stable rate: no non-DC spectral components'\n"
"          : 'No PSD samples', W / 2, chartH / 2);\n"
"      }\n"
"\n"
"      ctx.fillStyle = '#484f58';\n"
"      ctx.font = '9px monospace';\n"
"      ctx.textAlign = 'center';\n"
"      for (let i = 0; i < bins.length; i += 25) {\n"
"		const hz = ((i + 1) * 39.0625).toFixed(0);\n"
"        ctx.fillText(hz + 'Hz', i * barW + barW / 2, H - 3);\n"
"      }\n"
"\n"
"      for (let i = 0; i < bins.length; i++) {\n"
"        const db = maxVal > 0 && bins[i] > 0\n"
"          ? Math.max(-80, 10 * Math.log10(bins[i] / maxVal)) : -80;\n"
"        const ratio = (db + 80) / 80;\n"
"        const h = ratio * (chartH - 5);\n"
"        const x = i * barW;\n"
"        const y = chartH - h;\n"
"        const r = Math.floor(35 + ratio * 90);\n"
"        const g = Math.floor(130 + ratio * 80);\n"
"        const b = Math.floor(200 + ratio * 40);\n"
"        ctx.fillStyle = 'rgb(' + r + ',' + g + ',' + (b > 255 ? 255 : b) + ')';\n"
"        ctx.fillRect(x, y, barW - 1, h);\n"
"      }\n"
"\n"
"      for (let multiple = 1; pacingHz > 0 && multiple * pacingHz < 5000;\n"
"           multiple++) {\n"
"        const markerHz = multiple * pacingHz;\n"
"        if (markerHz < 39.0625) continue;\n"
"        const markerBin = markerHz / 39.0625 - 1;\n"
"        const x = (markerBin + 0.5) * barW;\n"
"        ctx.strokeStyle = '#f0883e';\n"
"        ctx.lineWidth = 1;\n"
"        ctx.setLineDash(multiple === 1 ? [] : [3, 3]);\n"
"        ctx.beginPath();\n"
"        ctx.moveTo(x, 0);\n"
"        ctx.lineTo(x, chartH);\n"
"        ctx.stroke();\n"
"        ctx.setLineDash([]);\n"
"        ctx.fillStyle = '#f0883e';\n"
"        ctx.font = '9px monospace';\n"
"        ctx.textAlign = x > W - 30 ? 'right' : 'left';\n"
"        ctx.fillText(multiple + '\\u00d7', x, 10);\n"
"      }\n"
"\n"
"      ctx.save();\n"
"      ctx.fillStyle = '#484f58';\n"
"      ctx.font = '9px monospace';\n"
"      ctx.textAlign = 'center';\n"
"      ctx.translate(10, chartH / 2);\n"
"      ctx.rotate(-Math.PI / 2);\n"
"      ctx.fillText('magnitude', 0, 0);\n"
"      ctx.restore();\n"
"    }\n"
"  }\n"
"\n"
"  // -- MI Matrix Heatmap Update --\n"
"  const N = MI_DIMS.length;\n"
"  if (sectionExpanded('body-mi')) for (let r = 0; r < N; r++) {\n"
"    const dim = MI_DIMS[r];\n"
"    for (let c = 0; c < N; c++) {\n"
"      const cellId = 'mc-' + r + '-' + c;\n"
"      const valEl = document.getElementById(cellId + '-v');\n"
"      if (!valEl) continue;\n"
"      const cellEl = document.getElementById(cellId);\n"
"      if (!cellEl) continue;\n"
"\n"
"      if (r === c) {\n"
"        // Diagonal: individual entropy\n"
"        const v = e[dim.id];\n"
"        if (v === undefined) continue;\n"
"        const maxVal = dim.maxKey && e[dim.maxKey] > 0 ? e[dim.maxKey] : dim.max;\n"
"        valEl.textContent = v.toFixed(2);\n"
"        cellEl.style.cssText = heatBg(v, maxVal, true) + ';grid-row:' + (r + 2) + ';grid-column:' + (c + 2) + ';';\n"
"      } else {\n"
"        const entry = MI_MAP[miKey(r, c)];\n"
"        if (!entry) continue; // no MI data cell\n"
"        const v = e[entry.miKey];\n"
"        if (v === undefined) continue;\n"
"        const cmax = e[entry.miMaxKey];\n"
"        const maxVal = (cmax > 0) ? cmax : (entry.absMax || 16);\n"
"        valEl.textContent = v.toFixed(2);\n"
"        cellEl.style.cssText = heatBg(v, maxVal, false) + ';grid-row:' + (r + 2) + ';grid-column:' + (c + 2) + ';';\n"
"\n"
"        // Tooltip\n"
"        const tipEl = document.getElementById(cellId + '-tip');\n"
"        if (tipEl) {\n"
"          let tipText = entry.label + ' = ' + v.toFixed(3) + ' bits';\n"
"          if (cmax > 0) tipText += ' (observed bound: ' + cmax.toFixed(2) + ')';\n"
"          tipEl.textContent = tipText;\n"
"        }\n"
"      }\n"
"    }\n"
"  }\n"
"\n"
"  // Detail list below matrix\n"
"  if (sectionExpanded('body-mi')) for (const k in MI_MAP) {\n"
"    const entry = MI_MAP[k];\n"
"    const v = e[entry.miKey];\n"
"    if (v === undefined) continue;\n"
"    updateValue('md-' + entry.miKey, v.toFixed(3));\n"
"  }\n"
"\n"
"  // -- MI Cards update --\n"
"  const miCardPairs = [\n"
"    { id: 'mi_sip_dip',   max: 16 },\n"
"    { id: 'mi_spt_dpt',   max: 8 },\n"
"    { id: 'mi_proto_spt', max: 6 },\n"
"    { id: 'mi_size_dpt',  max: 16 },\n"
"    { id: 'mi_size_proto',max: 8 },\n"
"    { id: 'mi_dtsc_proto',max: 8 },\n"
"    { id: 'mi_dtsc_flow', max: 16 },\n"
"    { id: 'mi_tcpf_sz',   max: 8 },\n"
"    { id: 'mi_tcpf_spt',  max: 8 },\n"
"    { id: 'mi_tcpf_dpt',  max: 8 },\n"
"    { id: 'mi_osip_odip', max: 16 },\n"
"    { id: 'mi_vni_osip',  max: 16 },\n"
"  ];\n"
"  if (sectionExpanded('body-mi-cards')) miCardPairs.forEach(p => {\n"
"    const val = e[p.id];\n"
"    if (val === undefined) return;\n"
"    updateValue('mcv-' + p.id, val.toFixed(3));\n"
"    // Upper bound from the observed marginal entropies\n"
"    const cmax = e['mi_max_' + p.id];\n"
"    const el = document.getElementById('mcc-' + p.id);\n"
"    if (el) el.textContent = cmax > 0 ? ' (bound: ' + cmax.toFixed(1) + ')' : '';\n"
"    // Bar uses the smaller of the display maximum and observed bound\n"
"    const denom = (cmax > 0 && cmax < p.max) ? cmax : p.max;\n"
"    updateBar('mcb-' + p.id, (val / denom) * 100);\n"
"  });\n"
"}\n"
"\n"
"connect();\n"
"</script>\n"
"</body>\n"
"</html>\n"
"\n"
;
static const unsigned int entropy_html_len = sizeof(entropy_html) - 1;
