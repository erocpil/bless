"(function() {\n"
"'use strict';\n"
"\n"
"var unitScale = 'M';  // 'K', 'M', 'G'\n"
"\n"
"function getScale() {\n"
"  switch (unitScale) {\n"
"    case 'K': return { pps: 1000, bps: 1000000, ppsLabel: 'Kpps', bpsLabel: 'Kbps' };\n"
"    case 'M': return { pps: 1,    bps: 1000,     ppsLabel: 'Mpps', bpsLabel: 'Mbps' };\n"
"    case 'G': return { pps: 0.001,bps: 1,        ppsLabel: 'Gpps', bpsLabel: 'Gbps' };\n"
"  }\n"
"}\n"
"\n"
"window.toggleScale = function() {\n"
"  var next = { 'K': 'M', 'M': 'G', 'G': 'K' };\n"
"  unitScale = next[unitScale];\n"
"  var s = getScale();\n"
"  document.getElementById('btn-scale').textContent = unitScale + ' (pps/bps)';\n"
"  // gauge unit labels\n"
"  document.getElementById('u-rx-pps').textContent = s.ppsLabel;\n"
"  document.getElementById('u-tx-pps').textContent = s.ppsLabel;\n"
"  document.getElementById('u-rx-bps').textContent = s.bpsLabel;\n"
"  document.getElementById('u-tx-bps').textContent = s.bpsLabel;\n"
"  // chart labels\n"
"  charts.mpps.data.datasets[0].label = 'RX ' + s.ppsLabel;\n"
"  charts.mpps.data.datasets[1].label = 'TX ' + s.ppsLabel;\n"
"  charts.gbps.data.datasets[0].label = 'RX ' + s.bpsLabel;\n"
"  charts.gbps.data.datasets[1].label = 'TX ' + s.bpsLabel;\n"
"  document.getElementById('chart-title-bps').textContent = 'Bandwidth (' + s.bpsLabel + ')';\n"
"  redraw();\n"
"};\n"
"\n"
"// ---- WebSocket ----\n"
"function consumePageApiKey() {\n"
"  var query = new URLSearchParams(location.search);\n"
"  var fragment = new URLSearchParams(location.hash.replace(/^#/, ''));\n"
"  var key = fragment.get('api_key') || query.get('api_key') || '';\n"
"  if (key) {\n"
"    query.delete('api_key');\n"
"    fragment.delete('api_key');\n"
"    var clean = location.pathname +\n"
"      (query.toString() ? '?' + query.toString() : '') +\n"
"      (fragment.toString() ? '#' + fragment.toString() : '');\n"
"    history.replaceState(null, '', clean);\n"
"  }\n"
"  return key;\n"
"}\n"
"\n"
"var apiKey = consumePageApiKey();\n"
"var extra = apiKey ? '?api_key=' + encodeURIComponent(apiKey) : '';\n"
"var wsUrl = (location.protocol === 'https:' ? 'wss:' : 'ws:')\n"
"            + '//' + location.host + '/wsURL' + extra;\n"
"var ows = null;\n"
"var reconnectTimer = null;\n"
"\n"
"// ---- Data store ----\n"
"var samples = [];\n"
"var MAX_SAMPLES = 600;\n"
"var msgCount = 0;\n"
"\n"
"function debugLog(txt) { /* removed */ }\n"
"// ---- Charts ----\n"
"var charts = {};\n"
"\n"
"function makeChart(id, cfg) {\n"
"  var ctx = document.getElementById(id);\n"
"  if (!ctx || typeof Chart === 'undefined') {\n"
"    debugLog('Chart.js not loaded');\n"
"    return null;\n"
"  }\n"
"  var chartCtx = ctx.getContext('2d');\n"
"  return new Chart(chartCtx, {\n"
"    type: 'line',\n"
"    data: { labels: [], datasets: cfg.datasets },\n"
"    options: {\n"
"      responsive: true,\n"
"      maintainAspectRatio: false,\n"
"      animation: { duration: 0 },\n"
"      scales: {\n"
"        x: { display: true, ticks: { color: '#484f58', maxTicksLimit: 6, font: { size: 8 } }, grid: { color: '#21262d' } },\n"
"        y: { beginAtZero: true, grid: { color: '#21262d' }, ticks: { color: '#8b949e', font: { size: 9 } } }\n"
"      },\n"
"      plugins: {\n"
"        legend: { labels: { color: '#8b949e', boxWidth: 8, padding: 4, font: { size: 9 } } }\n"
"      },\n"
"      elements: { point: { radius: 0 }, line: { borderWidth: 1 } }\n"
"    }\n"
"  });\n"
"}\n"
"\n"
"function initCharts() {\n"
"  charts.mpps = makeChart('chart-mpps', {\n"
"    datasets: [\n"
"      { label: 'RX ' + unitScale, data: [], borderColor: '#58a6ff', backgroundColor: 'rgba(88,166,255,0.1)', fill: true, tension: 0.3 },\n"
"      { label: 'TX ' + unitScale, data: [], borderColor: '#3fb950', backgroundColor: 'rgba(63,185,80,0.1)', fill: true, tension: 0.3 }\n"
"    ]\n"
"  });\n"
"  charts.gbps = makeChart('chart-gbps', {\n"
"    datasets: [\n"
"      { label: 'RX Gbps', data: [], borderColor: '#d29922', backgroundColor: 'rgba(210,153,34,0.1)', fill: true, tension: 0.3 },\n"
"      { label: 'TX Gbps', data: [], borderColor: '#f0883e', backgroundColor: 'rgba(240,136,62,0.1)', fill: true, tension: 0.3 }\n"
"    ]\n"
"  });\n"
"  charts.cpuMem = makeChart('chart-cpu-mem', {\n"
"    datasets: [\n"
"      { label: 'Enabled-lcore utilization %', data: [], borderColor: '#f44', backgroundColor: 'rgba(255,68,68,0.1)', fill: true, tension: 0.3, yAxisID: 'y' },\n"
"      { label: 'Memory MB', data: [], borderColor: '#bc8cff', backgroundColor: 'rgba(188,140,255,0.1)', fill: true, tension: 0.3, yAxisID: 'y1' }\n"
"    ]\n"
"  });\n"
"  charts.cpuMem.options.scales.y1 = {\n"
"    beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { color: '#8b949e', font: { size: 9 } }\n"
"  };\n"
"  charts.loss = makeChart('chart-loss', {\n"
"    datasets: [\n"
"      { label: 'Loss Rate', data: [], borderColor: '#f44', backgroundColor: 'rgba(255,68,68,0.1)', fill: true, tension: 0.3 }\n"
"    ]\n"
"  });\n"
"  charts.loss.options.scales.y = {\n"
"    beginAtZero: true, grid: { color: '#21262d' }, ticks: { color: '#8b949e', font: { size: 9 },\n"
"      callback: function(v) { return (v*100).toFixed(2) + '%'; } }\n"
"  };\n"
"  charts.latency = makeChart('chart-latency', {\n"
"    datasets: [\n"
"      { label: 'p50 µs', data: [], borderColor: '#3fb950', backgroundColor: 'rgba(63,185,80,0.1)', fill: true, tension: 0.3 },\n"
"      { label: 'p95 µs', data: [], borderColor: '#d29922', backgroundColor: 'rgba(210,153,34,0.1)', fill: true, tension: 0.3 },\n"
"      { label: 'p99 µs', data: [], borderColor: '#f44', backgroundColor: 'rgba(255,68,68,0.1)', fill: true, tension: 0.3 }\n"
"    ]\n"
"  });\n"
"  charts.latTail = makeChart('chart-latency-tail', {\n"
"    datasets: [\n"
"      { label: 'p99.9 µs', data: [], borderColor: '#bc8cff', backgroundColor: 'rgba(188,140,255,0.1)', fill: true, tension: 0.3 }\n"
"    ]\n"
"  });\n"
"}\n"
"\n"
"function redraw() {\n"
"  if (samples.length === 0) return;\n"
"  var s = getScale();\n"
"  var labels = samples.map(function(s) { return new Date(s.ts).toLocaleTimeString(); });\n"
"  function get(series) { return samples.map(function(s) { return s.o ? (s.o[series] || 0) : 0; }); }\n"
"  function getLatency(series) {\n"
"    return samples.map(function(s) {\n"
"      return s.o && Number(s.o.lat_samples) > 0 && isFinite(s.o[series])\n"
"        ? Number(s.o[series]) : null;\n"
"    });\n"
"  }\n"
"\n"
"  if (charts.mpps) {\n"
"    charts.mpps.data.labels = labels;\n"
"    charts.mpps.data.datasets[0].data = get('rx_mpps').map(function(v) { return v * s.pps; });\n"
"    charts.mpps.data.datasets[1].data = get('tx_mpps').map(function(v) { return v * s.pps; });\n"
"    charts.mpps.update('none');\n"
"  }\n"
"\n"
"  if (charts.gbps) {\n"
"    charts.gbps.data.labels = labels;\n"
"    charts.gbps.data.datasets[0].data = get('rx_gbps').map(function(v) { return v * s.bps; });\n"
"    charts.gbps.data.datasets[1].data = get('tx_gbps').map(function(v) { return v * s.bps; });\n"
"    charts.gbps.update('none');\n"
"  }\n"
"\n"
"  if (charts.cpuMem) {\n"
"    charts.cpuMem.data.labels = labels;\n"
"    charts.cpuMem.data.datasets[0].data = get('enabled_lcore_utilization_ratio').map(function(v) { return v * 100; });\n"
"    charts.cpuMem.data.datasets[1].data = get('mem_rss_kb').map(function(v) { return v / 1024; });\n"
"    charts.cpuMem.update('none');\n"
"  }\n"
"\n"
"  if (charts.loss) {\n"
"    charts.loss.data.labels = labels;\n"
"    charts.loss.data.datasets[0].data = get('rx_loss_rate');\n"
"    charts.loss.update('none');\n"
"  }\n"
"\n"
"  if (charts.latency) {\n"
"    charts.latency.data.labels = labels;\n"
"    charts.latency.data.datasets[0].data = getLatency('lat_p50_us');\n"
"    charts.latency.data.datasets[1].data = getLatency('lat_p95_us');\n"
"    charts.latency.data.datasets[2].data = getLatency('lat_p99_us');\n"
"    charts.latency.update('none');\n"
"  }\n"
"  if (charts.latTail) {\n"
"    charts.latTail.data.labels = labels;\n"
"    charts.latTail.data.datasets[0].data = getLatency('lat_p999_us');\n"
"    charts.latTail.update('none');\n"
"  }\n"
"}\n"
"\n"
"// ---- Gauges ----\n"
"function fmtPps(v) {\n"
"  // v is already in the display unit (Mpps or Kpps after scaling)\n"
"  if (v < 0.0001) return (v * 1000000).toFixed(0) + ' pps';\n"
"  if (v < 0.1)    return v.toFixed(4);\n"
"  if (v < 1)      return v.toFixed(3);\n"
"  if (v < 100)    return v.toFixed(1);\n"
"  return v.toFixed(0);\n"
"}\n"
"\n"
"function fmtBps(v) {\n"
"  if (v < 0.001) return (v * 1000).toFixed(1) + 'm';\n"
"  if (v < 0.01)  return v.toFixed(4);\n"
"  if (v < 1)     return v.toFixed(3);\n"
"  if (v < 100)   return v.toFixed(1);\n"
"  return v.toFixed(0);\n"
"}\n"
"\n"
"function updateGauges(o) {\n"
"  if (!o) return;\n"
"  function setEl(id, val, cls) {\n"
"    var el = document.getElementById(id);\n"
"    if (el) { var num = typeof val === 'number' ? val : parseFloat(val); el.textContent = val != null && isFinite(num) ? val : '\\u2014'; if (cls) el.className = 'gauge-value ' + cls; }\n"
"  }\n"
"  var s = getScale();\n"
"  var rxPps = o.rx_mpps != null ? (o.rx_mpps * s.pps) : null;\n"
"  var txPps = o.tx_mpps != null ? (o.tx_mpps * s.pps) : null;\n"
"  setEl('g-rx-pps', rxPps != null ? fmtPps(rxPps) : '—');\n"
"  setEl('g-tx-pps', txPps != null ? fmtPps(txPps) : '—');\n"
"  setEl('g-rx-bps', o.rx_gbps != null ? fmtBps(o.rx_gbps * s.bps) : '—');\n"
"  setEl('g-tx-bps', o.tx_gbps != null ? fmtBps(o.tx_gbps * s.bps) : '—');\n"
"  var loss = o.rx_loss_rate;\n"
"  if (loss != null && isFinite(loss)) {\n"
"    var pct = (loss * 100);\n"
"    setEl('g-loss', pct.toFixed(3) + '%', pct > 1 ? 'red' : pct > 0.1 ? 'yellow' : 'green');\n"
"  } else { setEl('g-loss', '—'); }\n"
"  var cpu = o.process_cpu_cores;\n"
"  var cpuRatio = o.enabled_lcore_utilization_ratio;\n"
"  if (cpu != null && isFinite(cpu) && cpuRatio != null && isFinite(cpuRatio)) {\n"
"    var cpuPct = cpuRatio * 100;\n"
"    setEl('g-cpu', cpu.toFixed(2) + ' cores / ' + Number(o.enabled_lcores).toFixed(0) + ' (' + cpuPct.toFixed(1) + '%)', cpuPct > 80 ? 'red' : cpuPct > 50 ? 'yellow' : 'green');\n"
"  } else { setEl('g-cpu', '—'); }\n"
"  var memKb = o.mem_rss_kb;\n"
"  setEl('g-mem', memKb ? (memKb / 1024).toFixed(1) : '—');\n"
"  var sendCyc = o.tx_cycles_per_pkt;\n"
"  if (sendCyc != null && isFinite(sendCyc)) {\n"
"    setEl('g-send-cycles', sendCyc >= 1000 ? (sendCyc / 1000).toFixed(1) + 'K' : sendCyc.toFixed(0), 'green');\n"
"  } else { setEl('g-send-cycles', '—'); }\n"
"  var waitRatio = o.tx_wait_ratio;\n"
"  if (waitRatio != null && isFinite(waitRatio)) {\n"
"    setEl('g-wait-ratio', (waitRatio * 100).toFixed(1) + '%', waitRatio > 0.7 ? 'yellow' : 'green');\n"
"  } else { setEl('g-wait-ratio', '—'); }\n"
"  /* latency gauges */\n"
"  var hasLatency = Number(o.lat_samples) > 0;\n"
"  var lat = function(k) { return hasLatency && o[k] != null && isFinite(o[k]) ? Number(o[k]).toFixed(1) : '—'; };\n"
"  setEl('g-lat-p50',    lat('lat_p50_us'), 'green');\n"
"  setEl('g-lat-p95',    lat('lat_p95_us'), 'yellow');\n"
"  setEl('g-lat-p99',    lat('lat_p99_us'), o.lat_p99_us > 1000 ? 'red' : 'yellow');\n"
"  setEl('g-lat-p999',   lat('lat_p999_us'), o.lat_p999_us > 2000 ? 'red' : 'yellow');\n"
"  setEl('g-lat-samples', o.lat_samples != null ? o.lat_samples.toFixed(0) : '—', null);\n"
"  var latencyStatus = document.getElementById('latency-status');\n"
"  if (latencyStatus) {\n"
"    if (hasLatency) {\n"
"      latencyStatus.textContent = Number(o.lat_samples).toFixed(0) + ' samples in current window';\n"
"      latencyStatus.style.color = '#3fb950';\n"
"    } else if (Number(o.rx_mpps) > 0) {\n"
"      latencyStatus.textContent = 'RX is active but no latency samples; verify protocol parsing and response matching';\n"
"      latencyStatus.style.color = '#d29922';\n"
"    } else {\n"
"      latencyStatus.textContent = 'no samples; RX is idle — check the DUT return path and RX queue';\n"
"      latencyStatus.style.color = '#f0883e';\n"
"    }\n"
"  }\n"
"  var _t=document.getElementById('g-time');if(_t)_t.textContent=new Date().toLocaleTimeString();\n"
"}\n"
"\n"
"// ---- WebSocket handlers ----\n"
"function onWsMessage(ev) {\n"
"  msgCount++;\n"
"  try {\n"
"    var d = JSON.parse(ev.data);\n"
"    /* handle cmdReply in Console */\n"
"    if (d.cmdReply) {\n"
"      var co = document.getElementById('ocmdOutput');\n"
"      if (co) co.innerHTML += '% ' + d.cmdReply + '\\n\\n';\n"
"      return;\n"
"    }\n"
"    if (d.log) {\n"
"      var la = document.getElementById('ologArea');\n"
"      if (la) {\n"
"        var line = document.createElement('div');\n"
"        line.textContent = '[' + new Date().toLocaleTimeString() + '] ' + (typeof d.log === 'string' ? d.log : d.log.text || JSON.stringify(d.log));\n"
"        la.insertBefore(line, la.firstChild);\n"
"        while (la.children.length > 100) la.removeChild(la.lastChild);\n"
"      }\n"
"    }\n"
"    if (!d || !d.observe) return;\n"
"    var now = Date.now();\n"
"    samples.push({ ts: now, o: d.observe });\n"
"    var cutoff = now - 60000;\n"
"    while (samples.length > 0 && samples[0].ts < cutoff) { samples.shift(); }\n"
"    if (samples.length > MAX_SAMPLES) { samples.splice(0, samples.length - MAX_SAMPLES); }\n"
"    updateGauges(d.observe);\n"
"    redraw();\n"
"  } catch(e) { console.warn('observe parse err', e); }\n"
"}\n"
"\n"
"function connect() {\n"
"  if (ows && ows.readyState === WebSocket.OPEN) return;\n"
"  try {\n"
"    ows = new WebSocket(wsUrl);\n"
"  } catch(e) { console.error('WS create err', e); setTimeout(connect, 3000); return; }\n"
"  ows.onopen = function() {\n"
"    document.getElementById('status-dot').className = 'status-dot on';\n"
"    document.getElementById('status-text').textContent = 'connected';\n"
"  };\n"
"  ows.onmessage = onWsMessage;\n"
"  ows.onclose = function() {\n"
"    document.getElementById('status-dot').className = 'status-dot';\n"
"    document.getElementById('status-text').textContent = 'reconnecting…';\n"
"    if (reconnectTimer) clearTimeout(reconnectTimer);\n"
"    reconnectTimer = setTimeout(connect, 3000);\n"
"  };\n"
"  ows.onerror = function() { ows.close(); };\n"
"}\n"
"\n"
"// ---- Console functions ----\n"
"var ocmdOutput = document.getElementById('ocmdOutput');\n"
"var ocmdInput = document.getElementById('ocmdInput');\n"
"var oconsoleEl = document.getElementById('observe-console');\n"
"function sendOCmd() {\n"
"  if (!ows || ows.readyState !== WebSocket.OPEN) return;\n"
"  var t = ocmdInput.value.trim();\n"
"  if (!t) return;\n"
"  ows.send(JSON.stringify({ cmd: t }));\n"
"  ocmdOutput.textContent += '> ' + t + '\\n';\n"
"  ocmdOutput.scrollTop = ocmdOutput.scrollHeight;\n"
"  ocmdInput.value = '';\n"
"}\n"
"window.toggleOConsole = function() {\n"
"  oconsoleEl.classList.toggle('hidden');\n"
"  var btn = document.getElementById('observe-console-toggle');\n"
"  if (btn) btn.style.display = oconsoleEl.classList.contains('hidden') ? '' : 'none';\n"
"  var lastTab = localStorage.getItem('obs_console_tab') || 'cmd';\n"
"  switchOTab(lastTab);\n"
"}\n"
"window.switchOTab = function(name, ev) {\n"
"  localStorage.setItem('obs_console_tab', name);\n"
"  document.querySelectorAll('#observe-console-tabs button').forEach(function(b) { b.classList.remove('active'); });\n"
"  document.querySelectorAll('#observe-console-body .tab').forEach(function(t) { t.classList.remove('active'); });\n"
"  var tb = document.getElementById('otab-' + name);\n"
"  if (tb) tb.classList.add('active');\n"
"  if (ev && ev.target) ev.target.classList.add('active');\n"
"  else {\n"
"    document.querySelectorAll('#observe-console-tabs button').forEach(function(btn) {\n"
"      var oa = btn.getAttribute('onclick');\n"
"      if (oa && oa.includes(\"'\" + name + \"'\")) btn.classList.add('active');\n"
"    });\n"
"  }\n"
"}\n"
"if (ocmdInput) {\n"
"  ocmdInput.addEventListener('keydown', function(e) {\n"
"    if (e.key === 'Enter' && e.ctrlKey) { e.preventDefault(); sendOCmd(); }\n"
"  });\n"
"}\n"
"/* drag support */\n"
"(function() {\n"
"  var hdr = document.getElementById('observe-console-header');\n"
"  if (!hdr || !oconsoleEl) return;\n"
"  var dragging = false, ox = 0, oy = 0;\n"
"  hdr.onmousedown = function(e) {\n"
"    dragging = true;\n"
"    ox = e.clientX - oconsoleEl.offsetLeft;\n"
"    oy = e.clientY - oconsoleEl.offsetTop;\n"
"  };\n"
"  document.onmousemove = function(e) {\n"
"    if (!dragging) return;\n"
"    oconsoleEl.style.left = (e.clientX - ox) + 'px';\n"
"    oconsoleEl.style.top = (e.clientY - oy) + 'px';\n"
"    oconsoleEl.style.right = 'auto';\n"
"    oconsoleEl.style.bottom = 'auto';\n"
"  };\n"
"  document.onmouseup = function() { dragging = false; };\n"
"})();\n"
"// ---- Init ----\n"
"initCharts();\n"
"connect();\n"
"})();\n"
"</script>\n"
"</body>\n"
"</html>\n"
"\n"
;
static const unsigned int observe_html_len = sizeof(observe_html) - 1;
